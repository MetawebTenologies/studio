{
  "name": "timecapsule-studio",
  "description": "Timecapsule — Multimodal AI cinema, video, image, and lip-sync studio",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "workspaces": [
    "packages/studio",
    "packages/timecapsule"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:studio && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://localhost:5432/timecapsule_test} TIMECAPSULE_ALLOW_DESTRUCTIVE_TEST_DB=1 node --test --test-concurrency=1 tests/timecapsule.test.mjs tests/tenancy.test.mjs tests/uploads_and_parity.test.mjs tests/firebase_auth_server.test.mjs",
    "migrate": "npm run db:migrate",
    "seed": "npm run db:seed",
    "reconcile": "npm run db:reconcile",
    "db:migrate": "node --env-file-if-exists=.env packages/timecapsule/src/scripts/db-cli.js migrate",
    "db:status": "node --env-file-if-exists=.env packages/timecapsule/src/scripts/db-cli.js status",
    "db:seed": "node --env-file-if-exists=.env packages/timecapsule/src/scripts/db-cli.js seed",
    "db:reconcile": "node --env-file-if-exists=.env packages/timecapsule/src/scripts/reconcile-cli.js",
    "worker": "node --env-file-if-exists=.env packages/timecapsule/src/scripts/worker-cli.js",
    "build:studio": "cd packages/studio && npm run build",
    "build:export": "node scripts/build-static.mjs",
    "deploy:firebase": "npm run build:export && firebase deploy --only hosting",
    "setup": "npm install && npm run build:studio",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "electron:build": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:all": "vite build && electron-builder --mac --win"
  },
  "build": {
    "appId": "studio.timecapsule.app",
    "productName": "Timecapsule Studio",
    "copyright": "Copyright © 2026 Timecapsule",
    "directories": {
      "output": "release"
    },
    "afterPack": "./afterPack.js",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "public/banner.png",
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/banner.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "axios": "^1.7.0",
    "firebase": "^13.1.0",
    "jose": "^6.2.13",
    "next": "^15.0.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.4.1",
    "studio": "*"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.1.18",
    "autoprefixer": "^10.4.24",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^5.4.0"
  }
}
