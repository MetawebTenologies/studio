{
  "name": "timecapsule-studio",
  "description": "Timecapsule — Multimodal AI cinema, video, image, and lip-sync studio",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/studio",
    "packages/timecapsule"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:studio && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/timecapsule.test.mjs",
    "build:studio": "cd packages/studio && npm run build",
    "setup": "npm install && npm run build:studio",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "electron:build": "vite build && electron-builder --mac",
    "electron:build:win": "vite build && electron-builder --win",
    "electron:build:all": "vite build && electron-builder --mac --win"
  },
  "build": {
    "appId": "studio.timecapsule.app",
    "productName": "Timecapsule Studio",
    "copyright": "Copyright © 2026 Timecapsule",
    "directories": { "output": "release" },
    "afterPack": "./afterPack.js",
    "files": ["dist/**/*", "electron/**/*"],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "public/banner.png",
      "gatekeeperAssess": false,
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }]
    },
    "win": {
      "icon": "public/banner.png",
      "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }]
    }
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "studio": "*",
    "axios": "^1.7.0",
    "react-hot-toast": "^2.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "autoprefixer": "^10.4.24",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^5.4.0",
    "@tailwindcss/vite": "^4.1.18"
  }
}
