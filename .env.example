# Timecapsule Environment Configuration (Placeholders Only — Never Commit Real Secrets)

# PostgreSQL connection string (Required; server fails closed if missing or unreachable)
DATABASE_URL=postgresql://timecapsule:timecapsule_local_dev_only@127.0.0.1:5432/timecapsule

# Session signing secret (Required; minimum 16 characters)
TIMECAPSULE_SESSION_SECRET=replace-with-random-32-byte-secret-value

# Single-tenant private-preview operator credential (Required; minimum 8 characters)
TIMECAPSULE_PREVIEW_KEY=replace-with-private-preview-operator-key

# ==============================================================================
# Multi-Provider Cascade Router Credentials
# At least one provider key is required for live generation.
# In cascade mode, the worker routes in order: muapi -> fal -> replicate -> kie.
# If MuAPI is unconfigured or out of balance, the gateway seamlessly executes on Fal or Replicate.
# ==============================================================================

# Fal.ai API key (Required for fal-ai/flux/dev, fal-ai/flux/schnell, and cascade failovers)
FAL_KEY=replace-with-fal-api-key

# Replicate API token (Required for black-forest-labs/flux-schnell and cascade failovers)
REPLICATE_API_TOKEN=replace-with-replicate-api-token

# Muapi.ai API key (Primary managed adapter; optional if defaulting to Fal or Replicate)
MUAPI_API_KEY=replace-with-muapi-api-key

# Kie.ai API key (Alternative adapter & Veo 3.1 routes; used when explicitly configured)
KIE_API_KEY=replace-with-kie-api-key

# Default provider override ('fal' | 'replicate' | 'muapi' | 'kie')
# Set to 'fal' or 'replicate' to route generation traffic directly without calling MuAPI:
# TIMECAPSULE_DEFAULT_PROVIDER=fal

# Optional provider endpoint base URL overrides
# TIMECAPSULE_FAL_BASE_URL=https://queue.fal.run
# TIMECAPSULE_REPLICATE_BASE_URL=https://api.replicate.com/v1

# Optional development seed configuration (used only by explicit `npm run db:seed`)
TIMECAPSULE_SEED_CREDITS=5000
