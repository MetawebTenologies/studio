# Timecapsule Environment Configuration (Placeholders Only — Never Commit Real Secrets)

# PostgreSQL connection string (Required; server fails closed if missing or unreachable)
DATABASE_URL=postgresql://timecapsule:timecapsule_local_dev_only@127.0.0.1:5432/timecapsule

# Session signing secret (Required; minimum 16 characters)
TIMECAPSULE_SESSION_SECRET=replace-with-random-32-byte-secret-value

# Single-tenant private-preview operator credential (Required; minimum 8 characters)
TIMECAPSULE_PREVIEW_KEY=replace-with-private-preview-operator-key

# Managed BFF provider API key (Kie.ai adapter; server fails closed before reservation if missing)
KIE_API_KEY=replace-with-kie-api-key

# Optional development seed configuration (used only by explicit `npm run db:seed`)
TIMECAPSULE_SEED_CREDITS=5000
